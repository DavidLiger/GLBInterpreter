# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# atelier (npm run atelier, A2) : dossier de travail de next dev
/.next-atelier/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .gitignore
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Médias lourds de la cartouche de test (contenu de développement, non versionné) : copiés localement
# dans public/ (voir README). Les assets d'un vrai livre sont copiés par le script de build (Î6).
public/models/
public/videos/
public/sounds/
public/spritesheets/
public/jsons
public/image/dioramas
# Ignore tout dans public/icons/dioramas
public/icons/dioramas/*

# Mais ne pas ignorer le dossier UI
!public/icons/dioramas/UI/

# Et ne pas ignorer son contenu
!public/icons/dioramas/UI/**

# src/content/webdioramas

# Service Worker généré
public/sw.js
public/sw.js.map
public/swe-worker-*.js

# Tokens en clair et QR d'impression (îlot 0) — jamais commités
/private/
# Index générés, QR d'impression (build-book : dist/qr/<bookId>/)
/dist/
# Livres (MJ3, décision de David du 30/10) : tout books/ est ignoré : livres de test synthétiques (npm run book:test-source,
# test-capsule, test-sans-jeu…), livres d'essai (test-jeu) et vrais livres (dinosaures, .blend et assets sous licence) ; un
# livre ne va jamais dans le dépôt public. Le studio accepte un livre rangé n'importe où.
/books/
# Livre de développement lu par `npm run dev` (npm run dev:book -- --source <dossier>, Î10)
/public/dev-book/


# Décodeurs copiés depuis three par scripts/copy-decoders.ts (predev / prebuild, Î7)
public/decoders/

# Studio de fabrication (npm run studio, ST1) : état des sorties, PID, réglages, journaux
/.studio/

# Guides en PDF (npm run docs:pdf, GD) : régénérés depuis docs/guide-*.md, jamais édités ni commités
/docs/pdf/

# Tests d'installation (Playwright, Î8)
/test-results/
/playwright-report/

*.patch